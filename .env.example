# =============================================================================
# Loy Payway — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All values below are safe defaults for local development.
# Demo mode is enabled by default — no real Bakong credentials needed to start.
# =============================================================================

# ---------------------------------------------------------------------------
# Bakong API (Cambodia's national payment system)
# ---------------------------------------------------------------------------
# Get your token from the Bakong Open API portal.
# Leave BAKONG_BEARER_TOKEN empty to use demo mode.
BAKONG_API_BASE=https://api-bakong.nbc.gov.kh
BAKONG_BEARER_TOKEN=
BAKONG_ACCOUNT_ID=your_account@bank_code

# ---------------------------------------------------------------------------
# Database (optional — falls back to in-memory if not configured)
# ---------------------------------------------------------------------------
# Supports PostgreSQL via Prisma. Supabase or any PostgreSQL host works.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Telegram Notifications (optional)
# ---------------------------------------------------------------------------
# Create a bot via @BotFather and get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
PORT=3000
API_SECRET_KEY=change-me-to-a-random-secret
POLL_INTERVAL_MS=5000
QR_EXPIRY_SECONDS=600

# ---------------------------------------------------------------------------
# Storage & Demo Mode
# ---------------------------------------------------------------------------
# Set to "memory" for local dev, or configure DATABASE_URL for PostgreSQL.
PAYWAY_STORAGE=memory
# Set to "false" to disable demo mode and require real Bakong credentials.
PAYWAY_ALLOW_DEMO=true

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
AUTH_JWT_SECRET=change-me-to-a-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_OTP_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# SMTP for OTP Delivery (optional)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Loy Payway
SMTP_SECURE=false
